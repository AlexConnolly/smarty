bin/
obj/
*.user
.vs/
# Local Whisper GGML model (downloaded on first use, ~140MB)
Smarty.Api/models/

# Captured interactions/feedback for fine-tuning (personal data)
Smarty.Api/training-data/
training-data/

# Local run/scratch artifacts
Smarty.Api/run.log
Smarty.Api/run.log.err
*.log
Smarty.Api/sid.txt
Smarty.Api/sse_*.txt

# Personal memory store
Smarty.Api/data/
data/
# Snapshots taken before wiping the assistant's state, so a reset is never one-way.
Smarty.Api/data-archive-*/
data-archive-*/

# Integration credentials (Kibana/GitHub/Jira tokens, endpoints) — NEVER commit
integrations.json
**/integrations.json

# Slack isolated data dir (memory/projects/uploads/schedules) if placed outside bin/
slack-data/
/dev/

# Local launch scripts / env files holding live secrets — NEVER commit
*.local.ps1
.env
.env.*

# Generated patches are the deliverable, not part of the tree — and a patch that
# contains itself is 160k lines of nothing.
*.patch

# Packaged plugins (scripts/pack-plugin.ps1) — build output, and the zip is whatever was last built.
/dist/

# Build output redirected into the repo so a build can run while the app holds bin/.
.brainbin/

# Scratch dumps from driving the widget/panel API by hand — API responses, not source.
/w*.json
/cs.json
Smarty.Api/b64_*.txt
Smarty.Api/leicester_2015-16_shirt.webp

# Running spend accounting, rewritten on every turn.
token_usage.json
